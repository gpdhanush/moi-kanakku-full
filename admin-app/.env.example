# Copy to .env for local development. Do not put real secrets in this file.

VITE_STATIC_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000/apis

VITE_ENV=development
MODE=development
VITE_APP_ENV=development

# Optional client identifiers (restricted Firebase web keys only — never service accounts)
ENCRYPTION_KEY=
FIREBASE_SERVICE_ACCOUNT=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_APP_VERSION=0.0.0
VITE_COMPANY_NAME=Moi Kanakku
