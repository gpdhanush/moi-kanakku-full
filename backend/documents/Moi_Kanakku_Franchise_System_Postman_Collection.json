  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"agprakash406@gmail.com\",\n  \"password\": \"AdminPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "admin", "login"]
            },
            "description": "Authenticates Admin / Super Admin and returns JWT token + franchise_context."
          }
        },
        {
          "name": "User / Staff / Customer Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"7845456609\",\n  \"password\": \"UserPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "login"]
            },
            "description": "Authenticates Direct User, Staff, or Customer and returns JWT token + franchise_context."
          }
        }
      ]
    },
