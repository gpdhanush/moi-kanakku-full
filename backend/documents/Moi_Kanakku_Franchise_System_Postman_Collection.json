      "key": "baseUrl",
      "value": "http://localhost:3000/apis",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "YOUR_ADMIN_JWT_TOKEN",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "YOUR_USER_JWT_TOKEN",
      "type": "string"
    },
    {
      "key": "franchiseId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "functionId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "customerUserId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "staffUserId",
      "value": "3",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "1",
      "type": "string"
    }
